---
// The interactive JSON widget. `mode` selects format vs minify and is read back
// by the client script, so both tool pages reuse this component.
interface Props {
  mode: 'format' | 'minify' | 'validate' | 'json-to-csv' | 'csv-to-json';
}

const { mode } = Astro.props;
const isFormat = mode === 'format';
const isConvert = mode === 'json-to-csv' || mode === 'csv-to-json';
const runLabel =
  mode === 'format'
    ? 'Format'
    : mode === 'validate'
      ? 'Validate'
      : mode === 'minify'
        ? 'Minify'
        : 'Convert';
const inputPlaceholder = mode === 'csv-to-json' ? 'Paste your CSV here…' : 'Paste your JSON here…';
---

<div data-json-tool data-mode={mode} class="mt-8">
  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-[var(--text-2)]" for="json-input">Input</label>
      <textarea
        id="json-input"
        data-input
        spellcheck="false"
        placeholder={inputPlaceholder}
        class="mt-1 h-72 w-full resize-y rounded-lg border border-[var(--border-2)] bg-[var(--surface)] p-3 font-mono text-sm text-[var(--text)] placeholder:text-[var(--text-6)] focus:border-[var(--accent)] focus:outline-none"
      ></textarea>
    </div>
    <div>
      <label class="block text-sm font-medium text-[var(--text-2)]">Output</label>
      <pre
        data-output
        class="mt-1 h-72 w-full overflow-auto rounded-lg border border-[var(--border-2)] bg-[var(--surface-2)] p-3 font-mono text-sm text-[var(--text)]"></pre>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button
      data-run
      type="button"
      class="rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white hover:bg-[var(--accent-hover)]"
    >
      {runLabel}
    </button>

    {
      isFormat && (
        <label class="flex items-center gap-2 text-sm text-[var(--text-3)]">
          Indent
          <select
            data-indent
            class="rounded-md border border-[var(--border-2)] bg-[var(--surface)] px-2 py-1 text-sm text-[var(--text)] focus:border-[var(--accent)] focus:outline-none"
          >
            <option value="2">2 spaces</option>
            <option value="4">4 spaces</option>
            <option value="tab">Tab</option>
          </select>
        </label>
      )
    }

    <button
      data-copy
      type="button"
      class="rounded-md border border-[var(--border-2)] bg-[var(--surface)] px-4 py-2 text-sm font-medium text-[var(--text-2)] hover:border-[var(--accent)] hover:text-[var(--text)]"
    >
      Copy
    </button>

    {
      isConvert && (
        <button
          data-download
          type="button"
          class="rounded-md border border-[var(--border-2)] bg-[var(--surface)] px-4 py-2 text-sm font-medium text-[var(--text-2)] hover:border-[var(--accent)] hover:text-[var(--text)]"
        >
          {mode === 'json-to-csv' ? 'Download CSV' : 'Download JSON'}
        </button>
      )
    }
  </div>

  <p data-status class="mt-2 text-sm text-[var(--text-4)]"></p>
  <p class="mt-1 text-xs text-[var(--text-6)]">
    100% in your browser — your data never leaves your device.
  </p>
</div>

<script>
  import '../scripts/json-tool.ts';
</script>
