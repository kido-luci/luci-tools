---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const title = 'Free Online Color Tools — HEX, RGB, HSL & Contrast | Luci Tools';
const description =
  'Convert colors and check contrast right in your browser — HEX to RGB, RGB to HEX, HEX to HSL and a WCAG contrast checker. 100% client-side, fast, free, nothing uploaded.';

const hubUrl = new URL(import.meta.env.BASE_URL, SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Color Tools',
  description,
  url: hubUrl,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-[1600px] px-4 pb-20 pt-14 sm:px-10">
    <h1 class="font-display text-[42px] font-bold leading-[1.1] tracking-[-0.025em] text-[var(--text)]">
      Color Tools
    </h1>
    <p class="mt-[18px] max-w-[880px] text-[19px] leading-[1.55] text-[var(--text-2)]">
      Fast, free and private color conversion that runs entirely in your browser.
      HEX, RGB, HSL and WCAG contrast — nothing is ever uploaded to a server.
    </p>

    <div class="mt-6 flex flex-wrap gap-[30px]">
      {
        ['100% in your browser', 'Nothing uploaded', 'Free & instant'].map((label) => (
          <div class="flex items-center gap-[9px]">
            <span
              class="inline-flex h-[22px] w-[22px] items-center justify-center rounded-full bg-[var(--accent-soft-bg)] text-xs font-bold text-[var(--accent)]"
              aria-hidden="true"
            >
              ✓
            </span>
            <span class="text-[14.5px] font-medium text-[var(--text-3)]">{label}</span>
          </div>
        ))
      }
    </div>

    <AdSlot />

    <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-[26px]">
      {
        TOOLS.map((t) => {
          const parts = t.title.split(' to ');
          const [from, to] = parts.length === 2 ? parts : [t.title, ''];
          return (
            <li>
              <a
                href={toolUrl(t.slug)}
                class="flex h-full gap-[18px] rounded-xl border border-[var(--border-3)] bg-[var(--surface)] px-7 py-[26px] text-[var(--text)] transition hover:-translate-y-0.5 hover:border-[var(--border-hover)] hover:shadow-[0_12px_26px_-16px_var(--card-shadow)]"
              >
                <div class="flex h-[60px] w-[60px] flex-shrink-0 flex-col items-center justify-center rounded-[14px] bg-tile-bg">
                  <span class="font-display text-sm font-bold text-tile-fg">{from}</span>
                  {to && <span class="mt-px text-[11px] font-semibold text-tile-fg opacity-80">→ {to}</span>}
                </div>
                <div>
                  <div class="text-[21px] font-bold text-[var(--text)]">{t.title}</div>
                  <div class="mt-2 text-[16px] leading-[1.55] text-[var(--text-4)]">{t.description}</div>
                  <div class="mt-[14px] text-sm font-bold text-[var(--accent)]">Open →</div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>
