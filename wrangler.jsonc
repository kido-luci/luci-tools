{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools-router",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Bound to the production host. The route's zone (luci-studio.com) must exist on
  // this Cloudflare account before `wrangler deploy` will attach the route.
  "routes": [
    { "pattern": "tools.luci-studio.com/*", "zone_name": "luci-studio.com" }
  ],
  "observability": { "enabled": true }
}
