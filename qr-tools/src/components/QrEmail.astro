---
// The interactive email → QR widget. The client script reads [data-qr-email],
// builds the mailto: payload from the fields, regenerates the preview on change,
// and wires the two download buttons.
---

<div data-qr-email class="mt-8">
  <div class="grid gap-4">
    <div>
      <label for="email-to" class="block text-sm font-medium text-[var(--text-2)]">
        Email address
      </label>
      <input
        id="email-to"
        type="email"
        autocomplete="off"
        placeholder="hello@example.com"
        class="mt-2 w-full rounded-xl border border-[var(--border-2)] bg-[var(--surface)] px-3 py-2 text-[var(--text)] shadow-sm focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] placeholder:text-[var(--text-6)]"
      />
    </div>

    <div>
      <label for="email-subject" class="block text-sm font-medium text-[var(--text-2)]">
        Subject <span class="font-normal text-[var(--text-6)]">(optional)</span>
      </label>
      <input
        id="email-subject"
        type="text"
        autocomplete="off"
        placeholder="Say hello"
        class="mt-2 w-full rounded-xl border border-[var(--border-2)] bg-[var(--surface)] px-3 py-2 text-[var(--text)] shadow-sm focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] placeholder:text-[var(--text-6)]"
      />
    </div>

    <div>
      <label for="email-body" class="block text-sm font-medium text-[var(--text-2)]">
        Message <span class="font-normal text-[var(--text-6)]">(optional)</span>
      </label>
      <textarea
        id="email-body"
        rows="3"
        placeholder="Pre-filled message body…"
        class="mt-2 w-full resize-y rounded-xl border border-[var(--border-2)] bg-[var(--surface)] px-3 py-2 text-[var(--text)] shadow-sm focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] placeholder:text-[var(--text-6)]"
      ></textarea>
    </div>
  </div>

  <p class="mt-2 text-xs text-[var(--text-6)]">
    100% in your browser — nothing you enter leaves your device.
  </p>

  <div class="mt-6 flex flex-col items-center">
    <div
      data-preview
      class="flex h-64 w-64 items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--surface)] p-3 text-center text-sm text-[var(--text-6)]"
    >
      Enter an email address to generate a QR code.
    </div>

    <div data-actions class="mt-4 hidden gap-3">
      <button
        data-download-png
        type="button"
        class="rounded-md bg-[var(--accent)] px-3 py-1.5 text-sm font-medium text-white hover:bg-[var(--accent-hover)]"
      >
        Download PNG
      </button>
      <button
        data-download-svg
        type="button"
        class="rounded-md border border-[var(--border-2)] bg-[var(--surface)] px-3 py-1.5 text-sm font-medium text-[var(--text-2)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
      >
        Download SVG
      </button>
    </div>
  </div>
</div>

<script>
  import '../scripts/qr-email.ts';
</script>
