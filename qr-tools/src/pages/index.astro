---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const title = 'Free Online QR Code Generator — Text, URL, WiFi | Luci Tools';
const description =
  'Generate QR codes right in your browser — from any text or URL, or a WiFi code guests can scan to connect. 100% client-side, free, nothing uploaded.';

const hubUrl = new URL(import.meta.env.BASE_URL, SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'QR Code Tools',
  description,
  url: hubUrl,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-[1600px] px-4 pb-20 pt-14 sm:px-10">
    <h1 class="font-display text-[42px] font-bold leading-[1.1] tracking-[-0.025em] text-[var(--text)]">QR Code Tools</h1>
    <p class="mt-[18px] max-w-[880px] text-[19px] leading-[1.55] text-[var(--text-2)]">
      Free, instant and private QR code generators that run entirely in your
      browser. Nothing you type is ever uploaded to a server.
    </p>

    <div class="mt-6 flex flex-wrap gap-[30px]">
      {['100% in your browser', 'Nothing uploaded', 'Free & instant'].map((label) => (
        <div class="flex items-center gap-[9px]">
          <span class="inline-flex h-[22px] w-[22px] items-center justify-center rounded-full bg-[var(--accent-soft-bg)] text-xs font-bold text-[var(--accent)]" aria-hidden="true">✓</span>
          <span class="text-[14.5px] font-medium text-[var(--text-3)]">{label}</span>
        </div>
      ))}
    </div>

    <AdSlot />

    <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-[26px]">
      {
        TOOLS.map((t) => {
          const [from, to] = t.slug.split('-to-').map((s: string) => s.toUpperCase());
          const isConv = t.slug.includes('-to-');
          return (
            <li>
              <a
                href={toolUrl(t.slug)}
                class="flex h-full gap-[18px] rounded-xl border border-[var(--border-3)] bg-[var(--surface)] px-7 py-[26px] text-[var(--text)] transition hover:-translate-y-0.5 hover:border-[var(--border-hover)] hover:shadow-[0_12px_26px_-16px_var(--card-shadow)]"
              >
                <div class="flex h-[60px] w-[60px] flex-shrink-0 flex-col items-center justify-center rounded-[14px] bg-tile-bg">
                  {isConv ? (
                    <>
                      <span class="font-display text-sm font-bold text-tile-fg">{from}</span>
                      <span class="mt-px text-[11px] font-semibold text-tile-fg opacity-80">→ {to}</span>
                    </>
                  ) : (
                    <span class="font-display text-sm font-bold text-tile-fg">QR</span>
                  )}
                </div>
                <div>
                  <div class="text-[21px] font-bold text-[var(--text)]">{t.title}</div>
                  <div class="mt-2 text-[16px] leading-[1.55] text-[var(--text-4)]">{t.description}</div>
                  <div class="mt-[14px] text-sm font-bold text-[var(--accent)]">Open →</div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>
