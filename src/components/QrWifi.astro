---
// The interactive WiFi → QR widget. The client script reads [data-qr-wifi],
// builds the WIFI: payload from the fields, regenerates the preview on change,
// and wires the two download buttons. The password field is hidden for open
// networks.
---

<div data-qr-wifi class="mt-8">
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label for="wifi-ssid" class="block text-sm font-medium text-[var(--text-2)]">
        Network name (SSID)
      </label>
      <input
        id="wifi-ssid"
        type="text"
        autocomplete="off"
        placeholder="MyHomeWiFi"
        class="mt-2 w-full rounded-xl border border-[var(--border-2)] bg-[var(--surface)] px-3 py-2 text-[var(--text)] shadow-sm focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] placeholder:text-[var(--text-6)]"
      />
    </div>

    <div>
      <label for="wifi-encryption" class="block text-sm font-medium text-[var(--text-2)]">
        Encryption
      </label>
      <select
        id="wifi-encryption"
        class="mt-2 w-full rounded-xl border border-[var(--border-2)] bg-[var(--surface)] px-3 py-2 text-[var(--text)] shadow-sm focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
      >
        <option value="WPA">WPA / WPA2</option>
        <option value="WEP">WEP</option>
        <option value="nopass">No password</option>
      </select>
    </div>

    <div data-password-field>
      <label for="wifi-password" class="block text-sm font-medium text-[var(--text-2)]">
        Password
      </label>
      <input
        id="wifi-password"
        type="text"
        autocomplete="off"
        placeholder="Wi-Fi password"
        class="mt-2 w-full rounded-xl border border-[var(--border-2)] bg-[var(--surface)] px-3 py-2 text-[var(--text)] shadow-sm focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] placeholder:text-[var(--text-6)]"
      />
    </div>

    <div class="sm:col-span-2">
      <label class="flex items-center gap-2 text-sm text-[var(--text-2)]">
        <input id="wifi-hidden" type="checkbox" class="rounded border-[var(--border-2)]" />
        Hidden network
      </label>
    </div>
  </div>

  <p class="mt-2 text-xs text-[var(--text-6)]">
    100% in your browser — nothing you enter leaves your device.
  </p>

  <div class="mt-6 flex flex-col items-center">
    <div
      data-preview
      class="flex h-64 w-64 items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--surface)] p-3 text-center text-sm text-[var(--text-6)]"
    >
      Enter your network name to generate a QR code.
    </div>

    <div data-actions class="mt-4 hidden gap-3">
      <button
        data-download-png
        type="button"
        class="rounded-md bg-[var(--accent)] px-3 py-1.5 text-sm font-medium text-white hover:bg-[var(--accent-hover)]"
      >
        Download PNG
      </button>
      <button
        data-download-svg
        type="button"
        class="rounded-md border border-[var(--border-2)] bg-[var(--surface)] px-3 py-1.5 text-sm font-medium text-[var(--text-2)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
      >
        Download SVG
      </button>
    </div>
  </div>
</div>

<script>
  import '../scripts/qr-wifi.ts';
</script>
