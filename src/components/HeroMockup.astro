---
// Decorative hero illustration: a faux browser window showing the tool
// categories as a tile grid. Purely visual (aria-hidden) — the six tiles are
// illustrative and intentionally generic, not navigation.
const ICONS = {
  image:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0z" />',
  pdf:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />',
  code:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />',
  text:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 6.75h15M12 6.75v10.5" />',
  convert:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />',
  lock:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />',
};

const tiles: { label: string; icon: string; active?: boolean }[] = [
  { label: 'Image', icon: ICONS.image },
  { label: 'PDF', icon: ICONS.pdf },
  { label: 'Code', icon: ICONS.code },
  { label: 'Text', icon: ICONS.text },
  { label: 'Convert', icon: ICONS.convert },
  { label: 'Private', icon: ICONS.lock, active: true },
];
---

<div aria-hidden="true" class="relative w-full max-w-[480px]">
  <div
    class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_24px_60px_-15px_rgba(79,82,217,0.22)] dark:border-slate-800 dark:bg-slate-900"
  >
    <!-- title bar -->
    <div class="flex items-center gap-2 border-b border-slate-100 px-4 py-3.5 dark:border-slate-800">
      <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
      <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
      <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
      <span class="ml-3 h-5 flex-1 rounded-full bg-slate-100 dark:bg-slate-800"></span>
    </div>

    <!-- category tiles -->
    <div class="grid grid-cols-3 gap-3 p-5">
      {
        tiles.map((t) => (
          <div
            class={`flex flex-col items-center gap-2.5 rounded-xl px-3 py-4 ${
              t.active ? 'bg-brand' : 'bg-slate-50 dark:bg-slate-800/60'
            }`}
          >
            <span
              class={`inline-flex h-9 w-9 items-center justify-center rounded-[10px] ${
                t.active
                  ? 'bg-white/20 text-white'
                  : 'bg-brand-tint text-brand-dark dark:bg-brand/15 dark:text-brand-light'
              }`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.7"
                stroke="currentColor"
                class="h-5 w-5"
                set:html={t.icon}
              />
            </span>
            <span
              class={`text-xs font-semibold ${
                t.active ? 'text-white' : 'text-slate-500 dark:text-slate-400'
              }`}
            >
              {t.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- floating trust badge -->
  <div
    class="absolute -bottom-3 right-5 inline-flex items-center gap-1.5 rounded-full bg-brand px-3.5 py-2 text-xs font-semibold text-white shadow-lg"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
      <path
        fill-rule="evenodd"
        d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z"
        clip-rule="evenodd"></path>
    </svg>
    100% on device
  </div>
</div>
