---
// The interactive text/URL → QR widget. The client script reads [data-qr-text],
// regenerates the preview as you type, and wires the two download buttons.
---

<div data-qr-text class="mt-8">
  <label for="qr-text-input" class="block text-sm font-medium text-slate-700">
    Text or URL
  </label>
  <textarea
    id="qr-text-input"
    rows="3"
    placeholder="https://example.com"
    class="mt-2 w-full resize-y rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
  ></textarea>
  <p class="mt-1 text-xs text-slate-400">
    100% in your browser — nothing you enter leaves your device.
  </p>

  <div class="mt-6 flex flex-col items-center">
    <div
      data-preview
      class="flex h-64 w-64 items-center justify-center rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-400"
    >
      Your QR code will appear here.
    </div>

    <div data-actions class="mt-4 hidden gap-3">
      <button
        data-download-png
        type="button"
        class="rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700"
      >
        Download PNG
      </button>
      <button
        data-download-svg
        type="button"
        class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600"
      >
        Download SVG
      </button>
    </div>
  </div>
</div>

<script>
  import '../scripts/qr-text.ts';
</script>
