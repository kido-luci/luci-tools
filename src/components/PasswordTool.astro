---
// The interactive generator widget. `mode` selects whether the page generates
// random-character passwords or word-based passphrases; the client script
// reads it back via `data-mode` so every tool page reuses this one component.
interface Props {
  mode: 'password' | 'passphrase';
}

const { mode } = Astro.props;
---

<div data-password-tool data-mode={mode} class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
  <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-700 dark:bg-slate-950">
    <code data-output class="min-w-0 flex-1 truncate font-mono text-lg text-slate-900 dark:text-slate-100"></code>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-copy
        class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        Copy
      </button>
      <button
        type="button"
        data-regenerate
        class="rounded-md bg-brand px-3 py-2 text-sm font-semibold text-white transition hover:bg-brand-dark"
      >
        Regenerate
      </button>
    </div>
  </div>

  <div class="mt-3 flex items-center gap-3">
    <div data-strength-bar class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
      <div data-strength-fill class="h-full w-0 rounded-full transition-all"></div>
    </div>
    <span data-strength-label class="shrink-0 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"></span>
  </div>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    <div data-length-control>
      <label class="flex items-center justify-between text-sm font-medium text-slate-700 dark:text-slate-300">
        <span data-length-field-label>Length</span>
        <span data-length-value class="font-mono text-slate-500 dark:text-slate-400"></span>
      </label>
      <input
        type="range"
        data-length
        min="6"
        max="64"
        value="16"
        class="mt-2 w-full accent-brand"
      />
    </div>

    <div data-class-controls class="flex flex-col justify-center gap-2 text-sm text-slate-700 dark:text-slate-300">
      <label class="flex items-center gap-2">
        <input type="checkbox" data-class="upper" checked class="accent-brand" />
        Uppercase (A-Z)
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" data-class="lower" checked class="accent-brand" />
        Lowercase (a-z)
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" data-class="digits" checked class="accent-brand" />
        Digits (0-9)
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" data-class="symbols" checked class="accent-brand" />
        Symbols (!@#$…)
      </label>
    </div>
  </div>

  <p class="mt-6 flex items-start gap-2 rounded-lg bg-brand-tint px-4 py-3 text-sm text-brand-dark dark:bg-brand/10 dark:text-brand-light">
    <span aria-hidden="true">🔒</span>
    <span>
      Generated entirely in your browser with <code class="font-mono">crypto.getRandomValues</code> —
      nothing is ever sent to a server.
    </span>
  </p>
</div>

<script>
  import '../scripts/password-tool.ts';
</script>
