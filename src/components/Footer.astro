---
// Legal pages live once at the root (tools-home), so link to them absolutely.
import { SITE } from '../consts';
---

<footer class="mt-12 border-t border-slate-200 bg-white">
  <div
    class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-[26px] text-[15px] text-slate-500 sm:px-10"
  >
    <p>© {SITE.name} — everything runs in your browser, nothing is uploaded.</p>
    <nav class="flex gap-4">
      <a href={`${SITE.url}/privacy/`} class="hover:text-slate-900">Privacy</a>
      <a href={`${SITE.url}/terms/`} class="hover:text-slate-900">Terms</a>
      <a href={`${SITE.url}/about/`} class="hover:text-slate-900">About</a>
    </nav>
  </div>
</footer>
