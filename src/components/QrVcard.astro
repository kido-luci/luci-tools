---
// The interactive contact → vCard QR widget. The client script reads
// [data-qr-vcard], builds the vCard 3.0 payload from the fields, regenerates
// the preview on change, and wires the two download buttons.
---

<div data-qr-vcard class="mt-8">
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="vcard-first" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
        First name
      </label>
      <input
        id="vcard-first"
        type="text"
        autocomplete="off"
        placeholder="Ada"
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      />
    </div>

    <div>
      <label for="vcard-last" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
        Last name
      </label>
      <input
        id="vcard-last"
        type="text"
        autocomplete="off"
        placeholder="Lovelace"
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      />
    </div>

    <div>
      <label for="vcard-phone" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
        Phone
      </label>
      <input
        id="vcard-phone"
        type="tel"
        autocomplete="off"
        placeholder="+1 555 000 1234"
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      />
    </div>

    <div>
      <label for="vcard-email" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
        Email
      </label>
      <input
        id="vcard-email"
        type="email"
        autocomplete="off"
        placeholder="ada@example.com"
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      />
    </div>

    <div>
      <label for="vcard-org" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
        Organization
      </label>
      <input
        id="vcard-org"
        type="text"
        autocomplete="off"
        placeholder="Analytical Engines Ltd"
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      />
    </div>

    <div>
      <label for="vcard-url" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
        Website
      </label>
      <input
        id="vcard-url"
        type="url"
        autocomplete="off"
        placeholder="https://example.com"
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      />
    </div>
  </div>

  <p class="mt-2 text-xs text-slate-400 dark:text-slate-500">
    100% in your browser — nothing you enter leaves your device.
  </p>

  <div class="mt-6 flex flex-col items-center">
    <div
      data-preview
      class="flex h-64 w-64 items-center justify-center rounded-xl border border-slate-200 bg-white p-3 text-center text-sm text-slate-400 dark:bg-slate-900 dark:border-slate-800 dark:text-slate-500"
    >
      Enter a name to generate a contact QR code.
    </div>

    <div data-actions class="mt-4 hidden gap-3">
      <button
        data-download-png
        type="button"
        class="rounded-md bg-brand px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-dark"
      >
        Download PNG
      </button>
      <button
        data-download-svg
        type="button"
        class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-brand-ring hover:text-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-300"
      >
        Download SVG
      </button>
    </div>
  </div>
</div>

<script>
  import '../scripts/qr-vcard.ts';
</script>
