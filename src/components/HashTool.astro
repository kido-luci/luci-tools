---
// The interactive hash widget. `algo` selects which digest to compute and is
// read back by the client script, so every hash page reuses this component.
// 'MD5' runs the pure-TS implementation; the SHA-* values are computed via
// the Web Crypto API — both happen live as the user types.
export type HashAlgo = 'MD5' | 'SHA-1' | 'SHA-256' | 'SHA-384' | 'SHA-512';

interface Props {
  algo: HashAlgo;
}

const { algo } = Astro.props;
---

<div data-hash-tool data-algo={algo} class="mt-8">
  <label for="hash-input" class="text-sm font-medium text-slate-700 dark:text-slate-300">
    Text to hash
  </label>
  <textarea
    id="hash-input"
    data-input
    rows="6"
    spellcheck="false"
    placeholder="Type or paste text here…"
    class="mt-2 w-full rounded-2xl border-2 border-slate-300 bg-white px-4 py-3 font-mono text-sm text-slate-900 outline-none transition-colors focus:border-brand dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
  ></textarea>
  <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">
    100% in your browser — your text never leaves your device.
  </p>

  <div class="mt-4">
    <div class="flex items-center justify-between">
      <span class="text-sm font-medium text-slate-700 dark:text-slate-300">{algo} hash</span>
      <button
        type="button"
        data-copy
        class="rounded-md bg-brand px-3 py-1 text-sm font-medium text-white transition hover:bg-brand-dark disabled:cursor-not-allowed disabled:opacity-50"
        disabled
      >
        Copy
      </button>
    </div>
    <output
      data-output
      class="mt-2 block break-all rounded-xl border border-slate-200 bg-[#f3f5fb] px-4 py-3 font-mono text-sm text-slate-500 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-500"
    >
      Start typing above to see the {algo} hash.
    </output>
  </div>
</div>

<script>
  import '../scripts/hash-tool.ts';
</script>
