---
// "FROM → TO" format tile shown beside a converter's title (e.g. HEIC → JPG).
// Pure text in a tinted brand tile so it stays crisp and theme-aware.
interface Props {
  from: string;
  to: string;
  class?: string;
}
const { from, to, class: className = '' } = Astro.props;
---

<span
  class={`inline-flex flex-col items-start justify-center rounded-[20px] bg-brand-tint px-[18px] py-4 dark:bg-brand/15 ${className}`}
  aria-hidden="true"
>
  <span class="text-[21px] font-extrabold leading-none tracking-[-0.02em] text-brand-dark dark:text-brand-light">{from}</span>
  <span class="mt-2 text-[15px] font-bold leading-none text-brand-light dark:text-brand-light/70">→ {to}</span>
</span>
