---
import { SITE } from '../consts';
---

<header class="border-b border-slate-200 bg-white dark:bg-slate-900 dark:border-slate-800">
  <div class="mx-auto flex max-w-[1600px] items-center justify-between px-4 py-[22px] sm:px-10">
    <a href="/" class="flex items-center gap-[11px]">
      <span
        class="inline-flex h-[30px] w-[30px] items-center justify-center rounded-[9px] bg-brand text-[15px] font-bold text-white"
        aria-hidden="true">L</span>
      <span class="whitespace-nowrap text-[21px] font-bold tracking-[-0.01em] text-slate-900 dark:text-slate-100">{SITE.name}</span>
    </a>
    <nav class="flex items-center gap-6 text-[15.5px] font-medium text-slate-600 dark:text-slate-400 sm:gap-[34px]">
      <a href="/about/" class="hover:text-slate-900 dark:hover:text-slate-100">About</a>
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="inline-flex h-[34px] w-[34px] items-center justify-center rounded-[9px] text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-[18px] w-[18px] dark:hidden" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="hidden h-[18px] w-[18px] dark:block" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
