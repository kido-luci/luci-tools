---
// Sticky cream header: logo mark, a search affordance that focuses the hub search
// (or navigates home from other pages), and the About link.
---

<header
  class="sticky top-0 z-50 border-b border-[#E7E1D5] bg-paper/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-[1180px] items-center justify-between gap-4 px-6">
    <a href="/" class="flex items-center gap-2.5 text-ink">
      <span class="flex h-7 w-7 items-center justify-center rounded-[9px] bg-ink" aria-hidden="true">
        <span class="h-[9px] w-[9px] rounded-[3px] bg-accent"></span>
      </span>
      <span class="font-display text-[18px] font-bold tracking-[-0.01em]">Luci</span>
      <span class="pt-[3px] font-mono text-[12px] tracking-[0.02em] text-[#6E6A5F]">tools</span>
    </a>
    <div class="flex items-center gap-4">
      <button
        type="button"
        id="header-search"
        class="hidden h-[34px] items-center gap-[9px] rounded-[9px] border border-[#E4DDCF] bg-[#FBF9F3] pl-3 pr-2.5 font-mono text-[12px] text-[#6E6A5F] transition hover:border-[#D6CEBE] hover:text-[#3A362E] sm:inline-flex"
      >
        <span>Search tools</span>
        <span class="rounded-[5px] border border-[#E4DDCF] px-[5px] py-px text-[11px] text-[#A7A192]">⌘K</span>
      </button>
      <a href="/about/" class="text-[14.5px] font-medium text-ink hover:text-accent">About</a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const focusSearch = () => {
      const el = document.getElementById('tool-search');
      if (el) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        el.focus();
      } else {
        window.location.href = '/';
      }
    };
    document.getElementById('header-search')?.addEventListener('click', focusSearch);
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && String(e.key).toLowerCase() === 'k') {
        e.preventDefault();
        focusSearch();
      }
    });
  })();
</script>
