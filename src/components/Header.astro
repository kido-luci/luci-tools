---
// Sticky cream header: logo mark, a search affordance that focuses the hub search
// (or navigates home from other pages), and the About link.
---

<header
  class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--header-bg)] backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-[1180px] items-center justify-between gap-4 px-6">
    <a href="/" class="flex items-center gap-2.5 text-[var(--text)]">
      <span class="flex h-7 w-7 items-center justify-center rounded-[9px] bg-[var(--text)]" aria-hidden="true">
        <span class="h-[9px] w-[9px] rounded-[3px] bg-[var(--accent)]"></span>
      </span>
      <span class="font-display text-[18px] font-bold tracking-[-0.01em]">Luci</span>
      <span class="pt-[3px] font-mono text-[12px] tracking-[0.02em] text-[var(--text-3)]">tools</span>
    </a>
    <div class="flex items-center gap-4">
      <button
        type="button"
        id="header-search"
        class="hidden h-[34px] items-center gap-[9px] rounded-[9px] border border-[var(--border-2)] bg-[var(--surface-2)] pl-3 pr-2.5 font-mono text-[12px] text-[var(--text-3)] transition hover:border-[var(--border-hover)] hover:text-[var(--pill-text)] sm:inline-flex"
      >
        <span>Search tools</span>
        <span class="rounded-[5px] border border-[var(--border-2)] px-[5px] py-px text-[11px] text-[var(--text-6)]">⌘K</span>
      </button>
      <a href="/about/" class="text-[14.5px] font-medium text-[var(--text)] hover:text-[var(--accent)]">About</a>
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="inline-flex h-[34px] w-[34px] items-center justify-center rounded-[9px] border border-[var(--border-2)] text-[var(--text-3)] transition hover:border-[var(--border-hover)] hover:text-[var(--text)]"
      >
        <svg class="h-[16px] w-[16px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="hidden h-[16px] w-[16px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const focusSearch = () => {
      const el = document.getElementById('tool-search');
      if (el) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        el.focus();
      } else {
        window.location.href = '/';
      }
    };
    document.getElementById('header-search')?.addEventListener('click', focusSearch);
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && String(e.key).toLowerCase() === 'k') {
        e.preventDefault();
        focusSearch();
      }
    });

    // Dark-mode toggle — writes the shared `theme` key the engine tool pages read.
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
  })();
</script>
