---
import { SITE } from '../consts';
import Icon from './Icon.astro';

const hub = import.meta.env.BASE_URL; // /fancy-text/
// Per-engine branding (kept distinct from the hub so tool pages keep category context).
const ENGINE = { label: 'Fancy Text', icon: 'sparkle', allLabel: 'All fancy text tools' };

// Show the Luci Studio brand mark only on the category hub; tool detail pages
// keep the category icon so each page stays focused on its tool.
const path = Astro.url.pathname.replace(/\/+$/, '');
const isHub = path === hub.replace(/\/+$/, '');
---

<header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-8 py-5">
    <a href={hub} class="flex items-center gap-[14px]">
      {
        isHub ? (
          <img src={`${hub}logo-icon.png`} class="h-10 w-10" alt="Luci Studio" />
        ) : (
          <span
            class="inline-flex h-10 w-10 items-center justify-center rounded-[11px] bg-gradient-to-br from-[#c026d3] to-[#d946ef] text-white shadow-[0_6px_14px_-4px_rgba(192,38,211,0.55)]"
            aria-hidden="true"
          >
            <Icon name={ENGINE.icon} stroke={1.9} class="h-[21px] w-[21px]" />
          </span>
        )
      }
      <span class="whitespace-nowrap text-[20px] font-bold text-slate-900 dark:text-slate-100">{ENGINE.label}</span>
    </a>
    <nav class="flex items-center gap-[26px] text-[15px] font-medium text-slate-600 dark:text-slate-400">
      <a href={hub} class="hidden hover:text-slate-900 dark:hover:text-slate-100 sm:inline">{ENGINE.allLabel}</a>
      <a href={`${SITE.url}/`} class="hover:text-slate-900 dark:hover:text-slate-100">{SITE.name}</a>
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="inline-flex h-[38px] w-[38px] items-center justify-center rounded-[10px] border border-[#e7e9f0] text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
      >
        <Icon name="moon" stroke={1.9} class="h-[17px] w-[17px] dark:hidden" />
        <Icon name="sun" stroke={1.9} class="hidden h-[17px] w-[17px] dark:block" />
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
