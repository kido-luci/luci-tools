---
import { SITE } from '../consts';
const hub = import.meta.env.BASE_URL; // /image/
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-[1600px] items-center justify-between px-4 py-[22px] sm:px-10">
    <a href={hub} class="flex items-center gap-[11px]">
      <span
        class="inline-flex h-[30px] w-[30px] items-center justify-center rounded-[9px] bg-brand text-base text-white"
        aria-hidden="true">⇄</span>
      <span class="whitespace-nowrap text-[21px] font-bold tracking-[-0.01em] text-slate-900">Image Tools</span>
    </a>
    <nav class="flex items-center gap-6 text-[15.5px] font-medium text-slate-600 sm:gap-[34px]">
      <a href={hub} class="hover:text-slate-900">All image tools</a>
      <a href={`${SITE.url}/`} class="hover:text-slate-900">{SITE.name}</a>
    </nav>
  </div>
</header>
