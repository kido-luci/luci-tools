---
import { SITE } from '../consts';
const hub = import.meta.env.BASE_URL; // /pdf/
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex h-14 max-w-4xl items-center justify-between px-4">
    <a href={hub} class="font-semibold text-slate-900">PDF Tools</a>
    <nav class="flex gap-4 text-sm text-slate-600">
      <a href={hub} class="hover:text-blue-600">All PDF tools</a>
      <a href={`${SITE.url}/`} class="hover:text-blue-600">{SITE.name}</a>
    </nav>
  </div>
</header>
