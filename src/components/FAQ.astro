---
// Renders the FAQ list and emits matching FAQPage JSON-LD for rich results.
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<section class="mt-12">
  <h2 class="text-xl font-semibold text-slate-900">Frequently asked questions</h2>
  <dl class="mt-4 divide-y divide-slate-200 border-y border-slate-200">
    {
      items.map((i) => (
        <div class="py-4">
          <dt class="font-medium text-slate-900">{i.q}</dt>
          <dd class="mt-1 text-slate-600">{i.a}</dd>
        </div>
      ))
    }
  </dl>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
