---
// The interactive email → QR widget. The client script reads [data-qr-email],
// builds the mailto: payload from the fields, regenerates the preview on change,
// and wires the two download buttons.
---

<div data-qr-email class="mt-8">
  <div class="grid gap-4">
    <div>
      <label for="email-to" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
        Email address
      </label>
      <input
        id="email-to"
        type="email"
        autocomplete="off"
        placeholder="hello@example.com"
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      />
    </div>

    <div>
      <label for="email-subject" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
        Subject <span class="font-normal text-slate-400 dark:text-slate-500">(optional)</span>
      </label>
      <input
        id="email-subject"
        type="text"
        autocomplete="off"
        placeholder="Say hello"
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      />
    </div>

    <div>
      <label for="email-body" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
        Message <span class="font-normal text-slate-400 dark:text-slate-500">(optional)</span>
      </label>
      <textarea
        id="email-body"
        rows="3"
        placeholder="Pre-filled message body…"
        class="mt-2 w-full resize-y rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      ></textarea>
    </div>
  </div>

  <p class="mt-2 text-xs text-slate-400 dark:text-slate-500">
    100% in your browser — nothing you enter leaves your device.
  </p>

  <div class="mt-6 flex flex-col items-center">
    <div
      data-preview
      class="flex h-64 w-64 items-center justify-center rounded-xl border border-slate-200 bg-white p-3 text-center text-sm text-slate-400 dark:bg-slate-900 dark:border-slate-800 dark:text-slate-500"
    >
      Enter an email address to generate a QR code.
    </div>

    <div data-actions class="mt-4 hidden gap-3">
      <button
        data-download-png
        type="button"
        class="rounded-md bg-brand px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-dark"
      >
        Download PNG
      </button>
      <button
        data-download-svg
        type="button"
        class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-brand-ring hover:text-brand dark:bg-slate-900 dark:border-slate-700 dark:text-slate-300"
      >
        Download SVG
      </button>
    </div>
  </div>
</div>

<script>
  import '../scripts/qr-email.ts';
</script>
