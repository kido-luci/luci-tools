---
// The interactive JSON widget. `mode` selects format vs minify and is read back
// by the client script, so both tool pages reuse this component.
interface Props {
  mode: 'format' | 'minify' | 'validate' | 'json-to-csv' | 'csv-to-json';
}

const { mode } = Astro.props;
const isFormat = mode === 'format';
const isConvert = mode === 'json-to-csv' || mode === 'csv-to-json';
const runLabel =
  mode === 'format'
    ? 'Format'
    : mode === 'validate'
      ? 'Validate'
      : mode === 'minify'
        ? 'Minify'
        : 'Convert';
const inputPlaceholder = mode === 'csv-to-json' ? 'Paste your CSV here…' : 'Paste your JSON here…';
---

<div data-json-tool data-mode={mode} class="mt-8">
  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-300" for="json-input">Input</label>
      <textarea
        id="json-input"
        data-input
        spellcheck="false"
        placeholder={inputPlaceholder}
        class="mt-1 h-72 w-full resize-y rounded-lg border border-slate-300 bg-white p-3 font-mono text-sm text-slate-900 focus:border-brand focus:outline-none dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500"
      ></textarea>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Output</label>
      <pre
        data-output
        class="mt-1 h-72 w-full overflow-auto rounded-lg border border-slate-300 bg-slate-50 p-3 font-mono text-sm text-slate-900 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100"></pre>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button
      data-run
      type="button"
      class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-dark"
    >
      {runLabel}
    </button>

    {
      isFormat && (
        <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
          Indent
          <select
            data-indent
            class="rounded-md border border-slate-300 bg-white px-2 py-1 text-sm focus:border-brand focus:outline-none dark:bg-slate-900 dark:border-slate-700 dark:text-slate-100"
          >
            <option value="2">2 spaces</option>
            <option value="4">4 spaces</option>
            <option value="tab">Tab</option>
          </select>
        </label>
      )
    }

    <button
      data-copy
      type="button"
      class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-brand hover:text-slate-900 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:text-slate-100"
    >
      Copy
    </button>

    {
      isConvert && (
        <button
          data-download
          type="button"
          class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-brand hover:text-slate-900 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:text-slate-100"
        >
          {mode === 'json-to-csv' ? 'Download CSV' : 'Download JSON'}
        </button>
      )
    }
  </div>

  <p data-status class="mt-2 text-sm text-slate-500 dark:text-slate-500"></p>
  <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">
    100% in your browser — your data never leaves your device.
  </p>
</div>

<script>
  import '../scripts/json-tool.ts';
</script>
