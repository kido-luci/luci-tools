---
// The interactive converter widget. `to` selects the output format and is read
// back by the client script, so every converter page reuses this component.
import type { TargetFormat } from '../lib/image';

interface Props {
  to: TargetFormat;
  accept?: string;
  prompt?: string;
}

const { to, accept = 'image/*', prompt = 'Drag & drop images here' } = Astro.props;
---

<div data-image-tool data-to={to} class="mt-8">
  <div
    data-dropzone
    class="flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-[var(--border-2)] bg-[var(--surface)] px-6 py-12 text-center transition-colors hover:border-[var(--accent)]"
  >
    <p class="text-[var(--text-2)]">
      {prompt}, or <span class="font-medium text-[var(--accent)]">browse</span>
    </p>
    <p class="mt-1 text-xs text-[var(--text-6)]">
      100% in your browser — your files never leave your device.
    </p>
    <input type="file" accept={accept} multiple class="hidden" />
  </div>

  <div data-results class="mt-4 space-y-2"></div>
</div>

<script>
  import '../scripts/image-tool.ts';
</script>
