---
// The interactive JSON widget. `mode` selects format vs minify and is read back
// by the client script, so both tool pages reuse this component.
interface Props {
  mode: 'format' | 'minify';
}

const { mode } = Astro.props;
const isFormat = mode === 'format';
---

<div data-json-tool data-mode={mode} class="mt-8">
  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-700" for="json-input">Input</label>
      <textarea
        id="json-input"
        data-input
        spellcheck="false"
        placeholder="Paste your JSON here…"
        class="mt-1 h-72 w-full resize-y rounded-lg border border-slate-300 bg-white p-3 font-mono text-sm text-slate-900 focus:border-brand focus:outline-none"
      ></textarea>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700">Output</label>
      <pre
        data-output
        class="mt-1 h-72 w-full overflow-auto rounded-lg border border-slate-300 bg-slate-50 p-3 font-mono text-sm text-slate-900"></pre>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button
      data-run
      type="button"
      class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-dark"
    >
      {isFormat ? 'Format' : 'Minify'}
    </button>

    {
      isFormat && (
        <label class="flex items-center gap-2 text-sm text-slate-600">
          Indent
          <select
            data-indent
            class="rounded-md border border-slate-300 bg-white px-2 py-1 text-sm focus:border-brand focus:outline-none"
          >
            <option value="2">2 spaces</option>
            <option value="4">4 spaces</option>
            <option value="tab">Tab</option>
          </select>
        </label>
      )
    }

    <button
      data-copy
      type="button"
      class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-brand hover:text-slate-900"
    >
      Copy
    </button>
  </div>

  <p data-status class="mt-2 text-sm text-slate-500"></p>
  <p class="mt-1 text-xs text-slate-400">
    100% in your browser — your data never leaves your device.
  </p>
</div>

<script>
  import '../scripts/json-tool.ts';
</script>
