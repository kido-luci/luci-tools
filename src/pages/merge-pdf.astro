---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolShell from '../components/ToolShell.astro';
import AdSlot from '../components/AdSlot.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import FormatBadge from '../components/FormatBadge.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const meta = TOOLS.find((t) => t.slug === 'merge-pdf')!;
const conv = meta.title.split(' to ');
const title = `${meta.h1} — Free & Private | ${SITE.name}`;
const canonical = new URL(toolUrl(meta.slug), SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: meta.h1,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any (web browser)',
  url: canonical,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqs: FaqItem[] = [
  {
    q: 'Are my PDF files uploaded to a server?',
    a: 'No. The merge happens entirely in your browser. Your PDFs never leave your device, so there is nothing to upload, store or delete afterwards.',
  },
  {
    q: 'How do I change the order of the files?',
    a: 'Files are merged in the order you add them. Add them in the order you want, or remove a file and add it again to move it to the end.',
  },
  {
    q: "Is there a limit on how many PDFs I can combine?",
    a: "There is no fixed limit. Because everything runs locally, the practical limit is your device’s memory — very large files simply take a little longer.",
  },
  {
    q: "Does merging reduce the quality of my PDFs?",
    a: "No. Pages are copied as-is into the new document, so text stays selectable and images keep their original resolution.",
  },
  {
    q: "Does it work with scanned PDFs?",
    a: "Yes. A scanned PDF is just a standard PDF whose pages happen to contain images rather than text. The tool copies those pages into the merged document exactly as they are.",
  },
  {
    q: "What about password-protected PDFs?",
    a: "Password-protected files cannot be read by the browser without the password. Remove the password protection first (using a tool that knows the password), then add the unlocked file here.",
  },
  {
    q: "In what order are the files combined?",
    a: "The files are combined in the order they appear in the list — top to bottom. To change the order, remove a file and add it again so it lands at the bottom of the list.",
  },
];
---

<BaseLayout title={title} description={meta.description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 pb-10 pt-12">
    {
      conv.length === 2 ? (
        <FormatBadge from={conv[0]} to={conv[1]} class="mb-5" />
      ) : (
        <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-[16px] bg-tile-bg text-tile-fg" aria-hidden="true">
          <Icon name={meta.icon} class="h-7 w-7" />
        </span>
      )
    }
    <h1 class="font-display text-4xl font-bold tracking-tight text-[var(--text)]">{meta.h1}</h1>
    <p class="mt-3 text-lg text-[var(--text-2)]">{meta.description}</p>

    <ToolShell
      mode="merge"
      accept="application/pdf,.pdf"
      cta="Merge PDFs"
      prompt="Drag & drop PDF files here"
    />

    <AdSlot />

    <div class="copy">
      <h2>How to merge PDF files</h2>
      <ol>
        <li>Drop your PDF files onto the box above, or click to browse.</li>
        <li>Check the list — files are combined top to bottom in that order.</li>
        <li>Click <strong>Merge PDFs</strong>, then download the single combined PDF.</li>
      </ol>

      <h2>Why merge PDFs in your browser?</h2>
      <p>
        Combining invoices, scanned pages or report sections into one file makes
        them far easier to share, print and archive. Because this tool runs
        completely on your device, sensitive documents like contracts and bank
        statements never travel across the internet — a real advantage over
        upload-based services.
      </p>

      <h2>What you can do</h2>
      <p>
        Drop two or more PDF files onto the box above and the tool combines every
        page from each file into a single new document. The files are joined in
        the order you add them — top to bottom in the list. There is no page
        limit and no file-count cap beyond what your device can hold in memory.
      </p>

      <h2>Common reasons to merge PDFs</h2>
      <ul>
        <li>Join scanned pages that came out as separate files into one complete document.</li>
        <li>Bundle a set of invoices or receipts into a single attachment for an expense report.</li>
        <li>Assemble a multi-section contract, application, or onboarding pack into one file before sending it.</li>
        <li>Combine individual chapters or sections of a report so readers get one download.</li>
        <li>Archive related correspondence or forms together so they are easy to find later.</li>
      </ul>

      <h2>Why browser-based merging keeps your files private</h2>
      <p>
        Many "merge PDF" websites require you to upload your files to their
        servers before processing them. That means your contracts, bank
        statements, medical records and IDs pass through a third-party computer
        you do not control. Here, everything is handled by <strong>pdf-lib</strong>
        running directly in your browser — your files are never sent anywhere.
        Once the merged PDF is downloaded you can close the tab and nothing
        persists: no copy on a server, no account required, no waiting for a
        deletion email.
      </p>

      <h2>Related tools</h2>
      <ul>
        <li><a href={toolUrl('jpg-to-pdf')} class="text-[var(--accent)] underline hover:no-underline">JPG to PDF converter</a> — turn photos or screenshots into a PDF you can then merge here.</li>
      </ul>
    </div>

    <FAQ items={faqs} />
  </article>
</BaseLayout>
