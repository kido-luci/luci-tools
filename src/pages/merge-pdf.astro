---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolShell from '../components/ToolShell.astro';
import AdSlot from '../components/AdSlot.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const meta = TOOLS.find((t) => t.slug === 'merge-pdf')!;
const title = `${meta.h1} — Free & Private | ${SITE.name}`;
const canonical = new URL(toolUrl(meta.slug), SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: meta.h1,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any (web browser)',
  url: canonical,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqs: FaqItem[] = [
  {
    q: 'Are my PDF files uploaded to a server?',
    a: 'No. The merge happens entirely in your browser. Your PDFs never leave your device, so there is nothing to upload, store or delete afterwards.',
  },
  {
    q: 'How do I change the order of the files?',
    a: 'Files are merged in the order you add them. Add them in the order you want, or remove a file and add it again to move it to the end.',
  },
  {
    q: 'Is there a limit on how many PDFs I can combine?',
    a: 'There is no fixed limit. Because everything runs locally, the practical limit is your device’s memory — very large files simply take a little longer.',
  },
  {
    q: 'Does merging reduce the quality of my PDFs?',
    a: 'No. Pages are copied as-is into the new document, so text stays selectable and images keep their original resolution.',
  },
];
---

<BaseLayout title={title} description={meta.description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 pb-10 pt-12">
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">{meta.h1}</h1>
    <p class="mt-3 text-lg text-slate-600">{meta.description}</p>

    <ToolShell
      mode="merge"
      accept="application/pdf,.pdf"
      cta="Merge PDFs"
      prompt="Drag & drop PDF files here"
    />

    <AdSlot />

    <div class="copy">
      <h2>How to merge PDF files</h2>
      <ol>
        <li>Drop your PDF files onto the box above, or click to browse.</li>
        <li>Check the list — files are combined top to bottom in that order.</li>
        <li>Click <strong>Merge PDFs</strong>, then download the single combined PDF.</li>
      </ol>

      <h2>Why merge PDFs in your browser?</h2>
      <p>
        Combining invoices, scanned pages or report sections into one file makes
        them far easier to share, print and archive. Because this tool runs
        completely on your device, sensitive documents like contracts and bank
        statements never travel across the internet — a real advantage over
        upload-based services.
      </p>
    </div>

    <FAQ items={faqs} />
  </article>
</BaseLayout>
