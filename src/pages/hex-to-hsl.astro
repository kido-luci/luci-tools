---
import BaseLayout from '../layouts/BaseLayout.astro';
import ColorTool from '../components/ColorTool.astro';
import AdSlot from '../components/AdSlot.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import FormatBadge from '../components/FormatBadge.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const meta = TOOLS.find((t) => t.slug === 'hex-to-hsl')!;
const title = `${meta.h1} — Free & Private | ${SITE.name}`;
const canonical = new URL(toolUrl(meta.slug), SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: meta.h1,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Any (web browser)',
  url: canonical,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqs: FaqItem[] = [
  {
    q: 'How do I convert HEX to HSL?',
    a: 'First convert hex to RGB, then derive hue from which channel is largest, saturation from how spread out the channels are, and lightness from the average of the largest and smallest channel. The tool above does all of this live as you type.',
  },
  {
    q: 'What do hue, saturation and lightness mean?',
    a: 'Hue (0–360°) is the position on the color wheel — red, yellow, green, and so on. Saturation (0–100%) is how vivid or gray the color is. Lightness (0–100%) is how close it is to black or white.',
  },
  {
    q: 'Why use HSL instead of HEX or RGB?',
    a: 'HSL separates a color from its intensity and shade, which makes it easy to create matching palettes — for example, keeping the same hue and saturation while only changing lightness to get a lighter or darker shade.',
  },
  {
    q: 'Does this tool support 3-digit shorthand hex codes?',
    a: 'Yes. A shorthand like #06c is expanded automatically to the equivalent full form, #0066cc, before the HSL values are computed.',
  },
  {
    q: 'Why are the hue, saturation and lightness values rounded?',
    a: 'They are rounded to whole numbers for readability, matching how HSL is normally written in CSS (e.g. hsl(217, 91%, 60%)). The rounding introduces only a negligible, usually invisible difference if converted back to hex.',
  },
  {
    q: 'Is my color data sent to a server?',
    a: 'No. The conversion is plain arithmetic that runs entirely in your browser with JavaScript — nothing is uploaded or logged.',
  },
];
---

<BaseLayout title={title} description={meta.description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 pb-10 pt-12">
    <FormatBadge from="HEX" to="HSL" class="mb-5" />
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">{meta.h1}</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{meta.description}</p>

    <ColorTool mode="hex-to-hsl" />

    <AdSlot />

    <div class="copy">
      <h2>How to convert HEX to HSL</h2>
      <ol>
        <li>Type or paste a hex color code into the box above (with or without the #).</li>
        <li>The RGB and HSL values update live as you type.</li>
        <li>Use the color picker next to the input to pick a color visually instead.</li>
      </ol>

      <h2>How the conversion works</h2>
      <p>
        HSL describes a color by hue, saturation and lightness instead of raw
        red/green/blue intensities. The engine first converts hex to RGB, finds
        which channel is largest to determine hue, measures the spread between
        the largest and smallest channel for saturation, and averages them for
        lightness — for example, <strong>#3b82f6</strong> becomes
        <strong>hsl(217, 91%, 60%)</strong>.
      </p>

      <h2>Where you'll need this</h2>
      <ul>
        <li>Building a color palette in CSS where you want to vary lightness (tints/shades) while keeping the same hue and saturation.</li>
        <li>Reading or debugging colors defined with <code>hsl()</code> in a stylesheet or design system.</li>
        <li>Explaining a color's visual properties — how vivid or how light it is — rather than its raw channel numbers.</li>
      </ul>

      <h2>Related tools</h2>
      <ul>
        <li><a href={toolUrl('hex-to-rgb')} class="text-brand underline hover:no-underline dark:text-brand-light">HEX to RGB converter</a> — get red, green and blue channels instead.</li>
        <li><a href={toolUrl('rgb-to-hex')} class="text-brand underline hover:no-underline dark:text-brand-light">RGB to HEX converter</a> — go from RGB back to hex.</li>
        <li><a href={toolUrl('color-contrast-checker')} class="text-brand underline hover:no-underline dark:text-brand-light">Color contrast checker</a> — check WCAG accessibility between two colors.</li>
      </ul>
    </div>

    <FAQ items={faqs} />
  </article>
</BaseLayout>
