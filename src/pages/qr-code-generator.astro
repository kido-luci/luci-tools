---
import BaseLayout from '../layouts/BaseLayout.astro';
import QrText from '../components/QrText.astro';
import AdSlot from '../components/AdSlot.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import FormatBadge from '../components/FormatBadge.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const meta = TOOLS.find((t) => t.slug === 'qr-code-generator')!;
const conv = meta.title.split(' to ');
const title = `${meta.h1} — Free & Private | ${SITE.name}`;
const canonical = new URL(toolUrl(meta.slug), SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: meta.h1,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (web browser)',
  url: canonical,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqs: FaqItem[] = [
  {
    q: 'Is anything I type uploaded to a server?',
    a: 'No. The QR code is generated entirely in your browser with JavaScript. The text or URL you enter never leaves your device.',
  },
  {
    q: 'Should I download the PNG or the SVG?',
    a: 'Use the PNG for websites, documents and quick sharing. Use the SVG when you need to print large — flyers, posters or packaging — because it stays perfectly sharp at any size.',
  },
  {
    q: 'Do these QR codes ever expire?',
    a: 'No. The code is a static image that encodes your text directly, so it works forever and keeps working even if this site goes away.',
  },
  {
    q: 'How much text can a QR code hold?',
    a: 'A lot — thousands of characters in theory — but shorter content scans far more reliably. For links, a plain URL is ideal.',
  },
  {
    q: 'Is there a scan limit or any tracking?',
    a: 'No. This is a plain static image — there is no redirect service, no analytics pixel, and nothing logged anywhere. Scans go directly to whatever content you encoded.',
  },
  {
    q: 'Can I print it large without it going blurry?',
    a: 'Yes. Download the SVG version and it will scale to any size — billboard or business card — without losing sharpness. The PNG is fixed resolution and is best kept at smaller print sizes.',
  },
  {
    q: 'What makes a QR code scan reliably?',
    a: 'Strong contrast (dark modules on a plain light background), a clear quiet-zone border around the code, and printing it large enough for a phone to focus on. Always test with your own phone before distributing a printed code.',
  },
];
---

<BaseLayout title={title} description={meta.description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 pb-10 pt-12">
    {
      conv.length === 2 ? (
        <FormatBadge from={conv[0]} to={conv[1]} class="mb-5" />
      ) : (
        <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-[16px] bg-brand-tint text-brand dark:bg-brand/15 dark:text-brand-light" aria-hidden="true">
          <Icon name={meta.icon} class="h-7 w-7" />
        </span>
      )
    }
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">{meta.h1}</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{meta.description}</p>

    <QrText />

    <AdSlot />

    <div class="copy">
      <h2>How to make a QR code</h2>
      <ol>
        <li>Type or paste any text or URL into the box above.</li>
        <li>The QR code is generated instantly, right in your browser.</li>
        <li>
          Click <strong>Download PNG</strong> for a ready-to-use image, or
          <strong>Download SVG</strong> for a sharp, print-ready vector.
        </li>
      </ol>

      <h2>What can you put in a QR code?</h2>
      <p>
        Anything that fits as text: a website link, a phone number, an email
        address, a short message, a product code, or plain notes. When someone
        points their phone camera at the code, their device reads the text and
        offers to open the link or copy the content — no app required on most
        modern phones.
      </p>

      <h2>PNG or SVG — which to download</h2>
      <p>
        PNG is a ready-to-use image that works in every email client, chat app
        and document. SVG is a vector file, so it scales to any size without
        blurring — the right choice for print, posters, signage or any
        situation where the final size is unknown. When in doubt: PNG for
        screens, SVG for print.
      </p>

      <h2>What you can put in a QR code</h2>
      <p>
        Any plain text works: a website URL is the most common use, but you can
        also encode a phone number, an email address, a calendar event link, a
        payment page, a social-media profile, or even a short note. WiFi
        credentials have their own format — use the{' '}
        <a href={toolUrl('wifi-qr-code-generator')} class="text-brand underline hover:no-underline dark:text-brand-light">WiFi QR code generator</a>
        {' '}for that. Whatever you encode, shorter content produces a less
        dense code that scans faster and more reliably.
      </p>

      <h2>Tips for QR codes that scan reliably</h2>
      <ul>
        <li><strong>Keep strong contrast</strong> — dark modules on a plain white or light background; avoid inverting colours or heavy tints.</li>
        <li><strong>Preserve the quiet zone</strong> — the blank margin around the code is part of the standard; cropping it confuses scanners.</li>
        <li><strong>Print it large enough</strong> — a code smaller than about 2 cm across can be hard for a phone camera to resolve.</li>
        <li><strong>Avoid heavy distortion</strong> — stretching or skewing the code breaks its geometry; slight logo overlays are fine if they stay small.</li>
        <li><strong>Test before distributing</strong> — scan it yourself on at least two devices before printing or publishing.</li>
      </ul>

      <h2>Related tools</h2>
      <ul>
        <li><a href={toolUrl('wifi-qr-code-generator')} class="text-brand underline hover:no-underline dark:text-brand-light">WiFi QR Code Generator</a> — create a scannable code that lets phones join your network without typing the password.</li>
      </ul>
    </div>

    <FAQ items={faqs} />
  </article>
</BaseLayout>
