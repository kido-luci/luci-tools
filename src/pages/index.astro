---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const title = 'Free Online PDF Tools — Merge PDF, JPG to PDF | Luci Tools';
const description =
  'Work with PDFs right in your browser — merge PDF files, convert JPG and PNG images to PDF, and more. 100% client-side, fast, free, nothing uploaded.';

const hubUrl = new URL(import.meta.env.BASE_URL, SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'PDF Tools',
  description,
  url: hubUrl,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-[1600px] px-4 pb-20 pt-14 sm:px-10">
    <h1 class="text-[42px] font-extrabold leading-[1.1] tracking-[-0.025em] text-slate-900">PDF Tools</h1>
    <p class="mt-[18px] max-w-[880px] text-[19px] leading-[1.55] text-slate-600">
      Fast, free and private PDF tools that run entirely in your browser. Your
      files are never uploaded to a server.
    </p>

    <div class="mt-6 flex flex-wrap gap-[30px]">
      {['100% in your browser', 'Nothing uploaded', 'Free & instant'].map((label) => (
        <div class="flex items-center gap-[9px]">
          <span class="inline-flex h-[22px] w-[22px] items-center justify-center rounded-full bg-brand-tint text-xs font-extrabold text-brand-dark" aria-hidden="true">✓</span>
          <span class="text-[14.5px] font-medium text-slate-600">{label}</span>
        </div>
      ))}
    </div>

    <AdSlot />

    <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-[26px]">
      {
        TOOLS.map((t) => {
          const [from, to] = t.slug.split('-to-').map((s) => s.toUpperCase());
          const isConv = t.slug.includes('-to-');
          return (
            <li>
              <a
                href={toolUrl(t.slug)}
                class="flex h-full gap-[18px] rounded-xl border border-slate-200 bg-white px-7 py-[26px] text-slate-900 transition hover:-translate-y-0.5 hover:border-brand-ring hover:shadow-[0_8px_24px_rgba(79,82,217,0.10)]"
              >
                <div class="flex h-[60px] w-[60px] flex-shrink-0 flex-col items-center justify-center rounded-[14px] bg-brand-tint">
                  {isConv ? (
                    <>
                      <span class="text-sm font-extrabold text-brand-dark">{from}</span>
                      <span class="mt-px text-[11px] font-semibold text-brand-light">→ {to}</span>
                    </>
                  ) : (
                    <span class="text-sm font-extrabold text-brand-dark">PDF</span>
                  )}
                </div>
                <div>
                  <div class="text-[21px] font-bold text-slate-900">{t.title}</div>
                  <div class="mt-2 text-[16px] leading-[1.55] text-slate-500">{t.description}</div>
                  <div class="mt-[14px] text-sm font-bold text-brand">Open →</div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>
