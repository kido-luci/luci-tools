---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const title = 'Free Online QR Code Generator — Text, URL, WiFi | Luci Tools';
const description =
  'Generate QR codes right in your browser — from any text or URL, or a WiFi code guests can scan to connect. 100% client-side, free, nothing uploaded.';

const hubUrl = new URL(import.meta.env.BASE_URL, SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'QR Code Tools',
  description,
  url: hubUrl,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">QR Code Tools</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Free, instant and private QR code generators that run entirely in your
      browser. Nothing you type is ever uploaded to a server.
    </p>

    <AdSlot />

    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        TOOLS.map((t) => (
          <li>
            <a
              href={toolUrl(t.slug)}
              class="block h-full rounded-lg border border-slate-200 bg-white p-4 transition-colors hover:border-blue-500 hover:shadow-sm"
            >
              <span class="font-semibold text-slate-900">{t.title}</span>
              <span class="mt-1 block text-sm text-slate-500">{t.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
