---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import EngineIcon from '../components/EngineIcon.astro';
import HeroMockup from '../components/HeroMockup.astro';
import { SITE, ENGINES, engineUrl, toolUrl } from '../consts';

const title = 'Free Online Tools — Image, PDF, JSON, QR & Text | Luci Tools';
const description =
  'A growing collection of fast, free, privacy-first web tools. Convert images and PDFs, format JSON, generate QR codes and fancy text — all 100% in your browser, nothing uploaded.';

const totalTools = ENGINES.reduce((n, e) => n + e.tools.length, 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL('/', SITE.url).href,
  description,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-6xl px-8 pb-20 pt-16">
    <!-- hero -->
    <section class="grid items-center gap-12 lg:grid-cols-[1fr_432px]">
      <div>
        <h1 class="text-[40px] font-extrabold leading-[1.07] tracking-[-0.03em] text-slate-900 dark:text-slate-100 sm:text-[56px] sm:leading-[1.05]">
          Free tools that run <span class="text-brand dark:text-brand-light">in your browser</span>
        </h1>
        <p class="mt-[18px] max-w-[500px] text-[18px] leading-[1.6] text-slate-500 dark:text-slate-400">
          {totalTools} fast, private tools for images, PDFs, code and text. Everything
          runs entirely on your device — your files are never uploaded to a server.
        </p>

        <div class="mt-7 flex flex-wrap gap-2.5">
          {
            ['100% in your browser', 'Nothing uploaded', 'Free & instant'].map((label) => (
              <div class="inline-flex items-center gap-[9px] rounded-full border border-[#e9ebf3] bg-white px-[15px] py-[9px] dark:border-slate-800 dark:bg-slate-900">
                <span class="inline-flex h-[18px] w-[18px] items-center justify-center rounded-full bg-brand-tint text-brand dark:bg-brand/15 dark:text-brand-light" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="h-[11px] w-[11px]">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                </span>
                <span class="text-[14px] font-semibold text-slate-700 dark:text-slate-300">{label}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="hidden lg:flex lg:justify-end">
        <HeroMockup />
      </div>
    </section>

    <div class="mt-12">
      <AdSlot />
    </div>

    {
      ENGINES.map((engine) => (
        <section id={engine.prefix} class="mt-16">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <span
              class="inline-flex h-[46px] w-[46px] flex-shrink-0 items-center justify-center rounded-[13px] bg-brand-tint text-brand dark:bg-brand/15 dark:text-brand-light"
              aria-hidden="true"
            >
              <EngineIcon prefix={engine.prefix} class="h-[22px] w-[22px]" />
            </span>
            <h2 class="text-[28px] font-bold tracking-[-0.02em] text-slate-900 dark:text-slate-100">
              {engine.name}
            </h2>
            <a
              href={engineUrl(engine.prefix)}
              class="text-[14px] font-semibold text-brand hover:underline dark:text-brand-light"
            >
              View all →
            </a>
          </div>
          <p class="mt-2.5 max-w-[760px] text-[15px] leading-[1.5] text-slate-500 dark:text-slate-400">
            {engine.blurb}
          </p>
          <ul class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-5">
            {engine.tools.map((t) => (
              <li>
                <a
                  href={toolUrl(engine.prefix, t.slug)}
                  class={`flex h-full flex-col rounded-[16px] border border-[#eceef4] bg-white transition hover:-translate-y-0.5 hover:border-brand-ring hover:shadow-[0_10px_28px_-6px_rgba(79,70,229,0.12)] dark:border-slate-800 dark:bg-slate-900 ${t.specimen ? 'p-6' : 'px-7 py-[26px]'}`}
                >
                  <div class="flex items-start justify-between">
                    <span
                      class="inline-flex h-[46px] w-[46px] items-center justify-center rounded-[12px] bg-brand-tint text-brand dark:bg-brand/15 dark:text-brand-light"
                      aria-hidden="true"
                    >
                      <EngineIcon prefix={engine.prefix} class="h-5 w-5" />
                    </span>
                    {t.specimen && (
                      <span
                        class="rounded-[8px] bg-[#f1f3f9] px-[11px] py-[5px] text-[16px] font-extrabold text-slate-400 dark:bg-slate-800 dark:text-slate-500"
                        aria-hidden="true"
                      >
                        {t.specimen}
                      </span>
                    )}
                  </div>
                  <div
                    class={`mt-4 font-bold text-slate-900 dark:text-slate-100 ${t.specimen ? 'text-[16px]' : 'text-[19px]'}`}
                  >
                    {t.title}
                  </div>
                  <div
                    class={`mt-1.5 flex-1 leading-[1.55] text-slate-500 dark:text-slate-400 ${t.specimen ? 'text-[14px]' : 'text-[14.5px]'}`}
                  >
                    {t.description}
                  </div>
                  <div class="mt-4 text-[14px] font-semibold text-brand dark:text-brand-light">Open →</div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
