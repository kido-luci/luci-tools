---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const title = 'Free Online Image Converter — HEIC, PNG, JPG | Luci Tools';
const description =
  'Convert images right in your browser — HEIC to JPG, PNG to JPG and more. 100% client-side, fast, free, nothing uploaded.';

const hubUrl = new URL(import.meta.env.BASE_URL, SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Image Converter Tools',
  description,
  url: hubUrl,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Image Converter Tools</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Fast, free and private image conversion that runs entirely in your browser.
      Your files are never uploaded to a server.
    </p>

    <AdSlot />

    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        TOOLS.map((t) => (
          <li>
            <a
              href={toolUrl(t.slug)}
              class="block h-full rounded-lg border border-slate-200 bg-white p-4 transition-colors hover:border-blue-500 hover:shadow-sm"
            >
              <span class="font-semibold text-slate-900">{t.title}</span>
              <span class="mt-1 block text-sm text-slate-500">{t.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
