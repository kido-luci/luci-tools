---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, TOOLS, toolUrl, DIMENSION_LABELS } from '../consts';
import type { ToolMeta } from '../consts';

const title = 'Free Online Unit Converter — Length, Weight & Temperature | Luci Tools';
const description =
  'Convert units right in your browser — cm to inches, kg to lbs, Celsius to Fahrenheit and more. 100% client-side, fast, free, nothing uploaded.';

const hubUrl = new URL(import.meta.env.BASE_URL, SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Unit Converter Tools',
  description,
  url: hubUrl,
};

// Group tools by dimension, preserving the order they first appear in TOOLS.
const groups: { key: ToolMeta['dimension']; label: string; tools: ToolMeta[] }[] = [];
for (const t of TOOLS) {
  let g = groups.find((x) => x.key === t.dimension);
  if (!g) {
    g = { key: t.dimension, label: DIMENSION_LABELS[t.dimension], tools: [] };
    groups.push(g);
  }
  g.tools.push(t);
}
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-[1600px] px-4 pb-20 pt-14 sm:px-10">
    <h1 class="font-display text-[42px] font-bold leading-[1.1] tracking-[-0.025em] text-[var(--text)]">
      Unit Converter Tools
    </h1>
    <p class="mt-[18px] max-w-[880px] text-[19px] leading-[1.55] text-[var(--text-2)]">
      Fast, free and private unit conversion that runs entirely in your browser.
      Length, weight and temperature — nothing is ever uploaded to a server.
    </p>

    <div class="mt-6 flex flex-wrap gap-[30px]">
      {
        ['100% in your browser', 'Nothing uploaded', 'Free & instant'].map((label) => (
          <div class="flex items-center gap-[9px]">
            <span
              class="inline-flex h-[22px] w-[22px] items-center justify-center rounded-full bg-[var(--accent-soft-bg)] text-xs font-bold text-[var(--accent)]"
              aria-hidden="true"
            >
              ✓
            </span>
            <span class="text-[14.5px] font-medium text-[var(--text-3)]">{label}</span>
          </div>
        ))
      }
    </div>

    <AdSlot />

    {
      groups.map((group) => (
        <div class="mt-10">
          <h2 class="font-display text-[24px] font-bold tracking-[-0.01em] text-[var(--text)]">{group.label}</h2>
          <ul class="mt-5 grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-[26px]">
            {group.tools.map((t) => {
              const [from, to] = t.title.split(' to ');
              return (
                <li>
                  <a
                    href={toolUrl(t.slug)}
                    class="flex h-full gap-[18px] rounded-xl border border-[var(--border-3)] bg-[var(--surface)] px-7 py-[26px] text-[var(--text)] transition hover:-translate-y-0.5 hover:border-[var(--border-hover)] hover:shadow-[0_12px_26px_-16px_var(--card-shadow)]"
                  >
                    <div class="flex h-[60px] w-[60px] flex-shrink-0 flex-col items-center justify-center rounded-[14px] bg-tile-bg">
                      <span class="font-display text-sm font-bold text-tile-fg">{from}</span>
                      <span class="mt-px text-[11px] font-semibold text-tile-fg opacity-80">→ {to}</span>
                    </div>
                    <div>
                      <div class="text-[21px] font-bold text-[var(--text)]">{t.title}</div>
                      <div class="mt-2 text-[16px] leading-[1.55] text-[var(--text-4)]">{t.description}</div>
                      <div class="mt-[14px] text-sm font-bold text-[var(--accent)]">Convert →</div>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
