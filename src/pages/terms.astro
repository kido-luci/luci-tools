---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Terms of Use | Luci Tools';
const description =
  'The terms for using Luci Tools — free, browser-based utilities provided as-is, with no warranty. Output is for reference only.';
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 pb-16 pt-12">
    <h1 class="font-display text-4xl font-bold tracking-tight text-[var(--text)]">Terms of Use</h1>
    <p class="mt-3 text-lg text-[var(--text-2)]">
      By using Luci Tools you agree to these terms. They are intentionally short.
    </p>

    <div class="copy">
      <p><em>Last updated: 27 June 2026.</em></p>

      <h2>The service</h2>
      <p>
        Luci Tools provides free utilities that run in your browser. We may add,
        change or remove tools at any time.
      </p>

      <h2>Provided “as is”</h2>
      <p>
        The tools are provided as-is, without warranty of any kind. Output is for
        reference — verify important results yourself. To the extent permitted by
        law, we are not liable for any loss arising from use of the tools.
      </p>

      <h2>Acceptable use</h2>
      <p>
        Use the tools lawfully. Do not attempt to disrupt, overload, reverse the
        service for abuse, or otherwise misuse it.
      </p>

      <h2>Your content</h2>
      <p>
        You keep all rights to the files you process. Because everything happens in
        your browser, we never receive or store your content.
      </p>

      <h2>Changes</h2>
      <p>
        We may update these terms. Continued use after a change means you accept the
        current version.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about these terms? Email
        <a href="mailto:lapl1412.work@gmail.com">lapl1412.work@gmail.com</a>.
      </p>
    </div>
  </article>
</BaseLayout>
