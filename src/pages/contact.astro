---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact | Luci Tools';
const description = 'Get in touch with Luci Tools — feedback, bug reports and questions.';
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 pb-16 pt-12">
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">Contact</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
      Questions, feedback or a bug to report? We’d love to hear from you.
    </p>

    <div class="copy">
      <h2>Email</h2>
      <p>
        Reach us at
        <a href="mailto:lapl1412.work@gmail.com">lapl1412.work@gmail.com</a>.
      </p>

      <h2>Reporting a problem</h2>
      <p>
        Tell us which tool you were using and what happened — the more detail, the
        faster we can fix it.
      </p>
    </div>
  </article>
</BaseLayout>
