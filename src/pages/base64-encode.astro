---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodecTool from '../components/CodecTool.astro';
import AdSlot from '../components/AdSlot.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const meta = TOOLS.find((t) => t.slug === 'base64-encode')!;
const title = `${meta.h1} — Free & Private | ${SITE.name}`;
const canonical = new URL(toolUrl(meta.slug), SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: meta.h1,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (web browser)',
  url: canonical,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqs: FaqItem[] = [
  {
    q: 'Is my text uploaded anywhere?',
    a: 'No. The encoding happens locally in your browser with the Web Crypto/TextEncoder APIs. Nothing is sent to a server, so passwords, tokens and private notes stay on your device.',
  },
  {
    q: 'Does this handle Unicode and emoji correctly?',
    a: 'Yes. Text is first converted to its UTF-8 byte sequence before Base64 encoding, so accented letters, CJK characters and emoji all round-trip correctly.',
  },
  {
    q: 'What is Base64 actually used for?',
    a: 'Base64 turns arbitrary binary data into plain ASCII text, which makes it safe to embed in places that only accept text — JSON payloads, URLs, email attachments, data: URIs and HTTP Basic Auth headers.',
  },
  {
    q: 'Is Base64 encoding the same as encryption?',
    a: 'No. Base64 is a reversible text encoding, not encryption — anyone can decode it instantly with no key. Never use Base64 alone to protect sensitive data.',
  },
  {
    q: 'Why does the output end with = signs?',
    a: 'Base64 groups input into 3-byte chunks and encodes each as 4 characters. When the last chunk is short, = padding characters fill the gap so decoders know where the data ends.',
  },
  {
    q: 'Can I encode a large block of text?',
    a: 'Yes, the textarea accepts as much text as your browser can hold in memory — there is no artificial length limit, and everything updates live as you type or paste.',
  },
];
---

<BaseLayout title={title} description={meta.description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 pb-10 pt-12">
    <span
      class="mb-4 flex h-14 w-14 items-center justify-center rounded-[16px] bg-brand-tint text-brand dark:bg-brand/15 dark:text-brand-light"
      aria-hidden="true"
    >
      <Icon name={meta.icon} class="h-7 w-7" />
    </span>
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">{meta.h1}</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{meta.description}</p>

    <CodecTool op="base64-encode" inputLabel="Text to encode" inputPlaceholder="Type or paste plain text here…" />

    <AdSlot />

    <div class="copy">
      <h2>How to Base64 encode text</h2>
      <ol>
        <li>Type or paste your text into the input box above.</li>
        <li>The Base64-encoded result appears instantly in the output box.</li>
        <li>Click <strong>Copy</strong> to copy the encoded string to your clipboard.</li>
      </ol>

      <h2>What this tool does</h2>
      <p>
        This tool converts plain text into Base64 — a text-safe representation
        of binary data made of the characters A–Z, a–z, 0–9, +, / and =. The
        input is first converted to its UTF-8 byte sequence, so the result is
        Unicode-safe: accented letters, CJK text and emoji all encode and
        decode correctly.
      </p>

      <h2>Common reasons to Base64 encode text</h2>
      <ul>
        <li>Embedding binary-ish data or credentials inside a JSON payload or config file.</li>
        <li>Building a <code>data:</code> URI to inline a small asset directly in HTML or CSS.</li>
        <li>Constructing an HTTP Basic Authentication header.</li>
        <li>Passing text safely through systems that only accept ASCII, like some legacy APIs or email transports.</li>
      </ul>

      <h2>Related tools</h2>
      <ul>
        <li><a href={toolUrl('base64-decode')} class="text-brand underline hover:no-underline dark:text-brand-light">Base64 Decode</a> — reverse this conversion back to plain text.</li>
        <li><a href={toolUrl('jwt-decoder')} class="text-brand underline hover:no-underline dark:text-brand-light">JWT Decoder</a> — decode a JSON Web Token's Base64url-encoded header and payload.</li>
      </ul>
    </div>

    <FAQ items={faqs} />
  </article>
</BaseLayout>
