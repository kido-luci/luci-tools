---
import BaseLayout from '../layouts/BaseLayout.astro';
import UnitConverter from '../components/UnitConverter.astro';
import AdSlot from '../components/AdSlot.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import FormatBadge from '../components/FormatBadge.astro';
import { SITE, TOOLS, toolUrl } from '../consts';

const meta = TOOLS.find((t) => t.slug === 'kg-to-lbs')!;
const [fromLabel, toLabel] = meta.title.split(' to ');
const title = `${meta.h1} — Free & Private | ${SITE.name}`;
const canonical = new URL(toolUrl(meta.slug), SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: meta.h1,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any (web browser)',
  url: canonical,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqs: FaqItem[] = [
  {
    q: 'How do I convert kilograms to pounds?',
    a: 'Multiply the kilogram value by 2.2046226218. For example, 5 kg × 2.2046226218 ≈ 11.02 lb. The converter above updates the result live.',
  },
  {
    q: 'How many pounds are in a kilogram?',
    a: 'One kilogram is about 2.2046 pounds. The reverse factor — pounds to kg — is exactly 0.45359237.',
  },
  {
    q: 'What is 70 kg in pounds, a common bodyweight?',
    a: '70 kg is about 154.32 lb (70 × 2.2046226218).',
  },
  {
    q: 'Why is the kg-to-lbs factor such a long decimal?',
    a: 'A pound is defined as exactly 0.45359237 kg, so its inverse doesn’t simplify to a clean number — 2.2046226218 is the precise reciprocal, often rounded to 2.2046 in everyday use.',
  },
  {
    q: 'Is this useful for gym plates and shipping weights?',
    a: 'Yes — this exact ratio is what’s used to convert gym plate weights (e.g. 20 kg ≈ 44.09 lb) and parcel weights between metric and imperial scales.',
  },
  {
    q: 'Does this tool send my weight data anywhere?',
    a: 'No. The conversion runs entirely in your browser — nothing you enter is uploaded, logged, or stored.',
  },
];

const rows = [
  ['1 kg', '2.2046 lb'],
  ['5 kg', '11.023 lb'],
  ['10 kg', '22.046 lb'],
  ['50 kg', '110.231 lb'],
  ['70 kg', '154.324 lb'],
  ['100 kg', '220.462 lb'],
];
---

<BaseLayout title={title} description={meta.description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 pb-10 pt-12">
    <FormatBadge from={fromLabel} to={toLabel} class="mb-5" />
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">{meta.h1}</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{meta.description}</p>

    <UnitConverter dimension={meta.dimension} from={meta.from} to={meta.to} />

    <AdSlot />

    <div class="copy">
      <h2>How to convert kg to lbs</h2>
      <ol>
        <li>Enter the weight in kilograms into the box above.</li>
        <li>The pound equivalent updates live as you type.</li>
        <li>Switch either dropdown to convert between any weight unit on this site.</li>
      </ol>

      <h2>The formula</h2>
      <p>Pounds are found by multiplying kilograms by 2.2046226218:</p>
      <p><strong>pounds = kilograms × 2.2046226218</strong></p>
      <p>Reversed, kilograms = pounds × 0.45359237.</p>

      <h2>Common kg to lbs values</h2>
      <table>
        <thead><tr><th>Kilograms</th><th>Pounds</th></tr></thead>
        <tbody>{rows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td></tr>)}</tbody>
      </table>

      <h2>Related tools</h2>
      <ul>
        <li><a href={toolUrl('lbs-to-kg')} class="text-brand underline hover:no-underline dark:text-brand-light">Lbs to KG converter</a> — go the other way.</li>
        <li><a href={toolUrl('cm-to-inches')} class="text-brand underline hover:no-underline dark:text-brand-light">CM to Inches converter</a> — for length conversions.</li>
      </ul>
    </div>

    <FAQ items={faqs} />
  </article>
</BaseLayout>
