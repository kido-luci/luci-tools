---
// The interactive generator widget. `mode` selects whether the page generates
// random-character passwords or word-based passphrases; the client script
// reads it back via `data-mode` so every tool page reuses this one component.
interface Props {
  mode: 'password' | 'passphrase';
}

const { mode } = Astro.props;
---

<div data-password-tool data-mode={mode} class="mt-8 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6">
  <div class="flex items-center justify-between gap-3 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] px-4 py-4">
    <code data-output class="min-w-0 flex-1 truncate font-mono text-lg text-[var(--text)]"></code>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-copy
        class="rounded-md border border-[var(--border-2)] px-3 py-2 text-sm font-medium text-[var(--text-2)] transition hover:border-[var(--border-hover)] hover:text-[var(--text)]"
      >
        Copy
      </button>
      <button
        type="button"
        data-regenerate
        class="rounded-md bg-[var(--accent)] px-3 py-2 text-sm font-semibold text-white transition hover:bg-[var(--accent-hover)]"
      >
        Regenerate
      </button>
    </div>
  </div>

  <div class="mt-3 flex items-center gap-3">
    <div data-strength-bar class="h-1.5 flex-1 overflow-hidden rounded-full bg-[var(--border)]">
      <div data-strength-fill class="h-full w-0 rounded-full transition-all"></div>
    </div>
    <span data-strength-label class="shrink-0 text-xs font-semibold uppercase tracking-wide text-[var(--text-4)]"></span>
  </div>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    <div data-length-control>
      <label class="flex items-center justify-between text-sm font-medium text-[var(--text-2)]">
        <span data-length-field-label>Length</span>
        <span data-length-value class="font-mono text-[var(--text-4)]"></span>
      </label>
      <input
        type="range"
        data-length
        min="6"
        max="64"
        value="16"
        class="mt-2 w-full accent-[var(--accent)]"
      />
    </div>

    <div data-class-controls class="flex flex-col justify-center gap-2 text-sm text-[var(--text-2)]">
      <label class="flex items-center gap-2">
        <input type="checkbox" data-class="upper" checked class="accent-[var(--accent)]" />
        Uppercase (A-Z)
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" data-class="lower" checked class="accent-[var(--accent)]" />
        Lowercase (a-z)
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" data-class="digits" checked class="accent-[var(--accent)]" />
        Digits (0-9)
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" data-class="symbols" checked class="accent-[var(--accent)]" />
        Symbols (!@#$…)
      </label>
    </div>
  </div>

  <p class="mt-6 flex items-start gap-2 rounded-lg bg-[var(--accent-soft-bg)] px-4 py-3 text-sm text-[var(--accent)]">
    <span aria-hidden="true">🔒</span>
    <span>
      Generated entirely in your browser with <code class="font-mono">crypto.getRandomValues</code> —
      nothing is ever sent to a server.
    </span>
  </p>
</div>

<script>
  import '../scripts/password-tool.ts';
</script>
