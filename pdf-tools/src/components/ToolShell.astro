---
// The interactive PDF widget. `mode` selects the operation and is read back by
// the client script, so both tool pages reuse this component. Files are queued,
// listed, then turned into a single downloadable PDF by the action button.
interface Props {
  mode: 'merge' | 'images' | 'rotate' | 'split';
  accept: string;
  cta: string;
  prompt?: string;
}

const { mode, accept, cta, prompt = 'Drag & drop files here' } = Astro.props;
// Rotate & split each act on one file; merge & images queue several.
const multiple = mode === 'merge' || mode === 'images';
---

<div data-pdf-tool data-mode={mode} class="mt-8">
  <div
    data-dropzone
    class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-[var(--border-2)] bg-[var(--surface)] px-6 py-12 text-center transition-colors"
  >
    <p class="text-[var(--text-2)]">
      {prompt}, or <span class="font-medium text-[var(--accent)]">browse</span>
    </p>
    <p class="mt-1 text-xs text-[var(--text-6)]">
      100% in your browser — your files never leave your device.
    </p>
    <input type="file" accept={accept} {...(multiple ? { multiple: true } : {})} class="hidden" />
  </div>

  <div data-files class="mt-4 space-y-2"></div>

  {
    mode === 'rotate' && (
      <label class="mt-4 flex items-center gap-2 text-sm text-[var(--text-2)]">
        Rotate by
        <select
          data-rotate-degrees
          class="rounded-md border border-[var(--border-2)] bg-[var(--surface)] px-2 py-1"
        >
          <option value="90">90° clockwise</option>
          <option value="180">180°</option>
          <option value="270">270° (90° counter-clockwise)</option>
        </select>
      </label>
    )
  }

  <button
    data-action
    type="button"
    disabled
    class="mt-4 rounded-md bg-[var(--accent)] px-4 py-2 font-medium text-white hover:bg-[var(--accent-hover)] disabled:cursor-not-allowed disabled:bg-[var(--border-2)]"
  >
    {cta}
  </button>

  <div data-results class="mt-4"></div>
  <p data-status class="mt-4 text-sm text-[var(--text-4)]"></p>
</div>

<script>
  import '../scripts/pdf-tool.ts';
</script>
