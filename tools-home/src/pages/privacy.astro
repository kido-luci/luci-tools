---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Privacy Policy | Luci Tools';
const description =
  'How Luci Tools handles your data: files are processed entirely in your browser and never uploaded. Details on analytics and advertising.';
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 pb-16 pt-12">
    <h1 class="font-display text-4xl font-bold tracking-tight text-[var(--text)]">Privacy Policy</h1>
    <p class="mt-3 text-lg text-[var(--text-2)]">
      Luci Tools is a collection of free web tools that run entirely in your browser.
      This page explains what is — and is not — collected when you use them.
    </p>

    <div class="copy">
      <p><em>Last updated: 27 June 2026.</em></p>

      <h2>Your files never leave your device</h2>
      <p>
        Every conversion and generation happens locally in your browser using
        JavaScript and WebAssembly. The files you open are processed on your own
        device and are never uploaded to, stored on, or seen by any server we run.
      </p>

      <h2>What we collect</h2>
      <p>
        We do not have accounts and we do not ask for personal information. To
        understand which tools are useful we use privacy-friendly analytics
        (Cloudflare Web Analytics), which counts page views without cookies and
        without tracking you across other sites.
      </p>

      <h2>Advertising</h2>
      <p>
        Pages may show ads served by Google AdSense. Google and its partners may use
        cookies to serve and measure ads. Where the law requires it, you will see a
        consent banner before any personalized advertising is used, and you can
        decline. You can review and manage your choices through Google’s Ads
        settings.
      </p>

      <h2>Third-party services</h2>
      <p>
        We rely on Cloudflare (hosting and analytics) and Google (AdSense). Each
        operates under its own privacy policy.
      </p>

      <h2>Children</h2>
      <p>The tools are general-purpose and are not directed at children under 13.</p>

      <h2>Changes</h2>
      <p>
        We may update this policy from time to time. The date above reflects the
        most recent version.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about privacy? Email
        <a href="mailto:lapl1412.work@gmail.com">lapl1412.work@gmail.com</a>.
      </p>
    </div>
  </article>
</BaseLayout>
