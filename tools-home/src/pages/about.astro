---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About | Luci Tools';
const description =
  'Luci Tools is a small portfolio of fast, free, privacy-first web tools that run 100% in your browser.';
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 pb-16 pt-12">
    <h1 class="font-display text-4xl font-bold tracking-tight text-[var(--text)]">About Luci Tools</h1>
    <p class="mt-3 text-lg text-[var(--text-2)]">
      Luci Tools is a small, growing collection of single-purpose web tools — image
      and PDF converters, generators and developer utilities — built to be fast,
      free and private.
    </p>

    <div class="copy">
      <h2>Private by design</h2>
      <p>
        Every tool runs entirely in your browser. Your files are processed on your
        device and never uploaded, so there is nothing for us to see or store. It is
        both a privacy posture and the reason the tools are instant.
      </p>

      <h2>Free to use</h2>
      <p>
        The tools are free, supported by unobtrusive ads placed around — never
        blocking — the tool itself.
      </p>

      <h2>How it’s built</h2>
      <p>
        Each page is a fast static page, with the actual work done client-side using
        JavaScript and WebAssembly, hosted on Cloudflare. New tools are added one
        search-intent at a time.
      </p>

      <h2>Get in touch</h2>
      <p>
        Feedback or a bug to report? See the
        <a href="/contact/">contact page</a>.
      </p>
    </div>
  </article>
</BaseLayout>
