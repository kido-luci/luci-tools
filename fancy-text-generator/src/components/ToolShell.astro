---
// The interactive fancy-text widget. `style` selects the transform and is read
// back by the client script, so every generator page reuses this component.
import type { Style } from '../lib/fancy';

interface Props {
  style: Style;
  placeholder?: string;
}

const { style, placeholder = 'Type or paste your text here…' } = Astro.props;
---

<div data-fancy-tool data-style={style} class="mt-8">
  <label class="block text-sm font-medium text-[var(--text-2)]" for="fancy-input">
    Your text
  </label>
  <textarea
    id="fancy-input"
    data-input
    rows="3"
    placeholder={placeholder}
    class="mt-1 w-full resize-y rounded-xl border border-[var(--border-2)] bg-[var(--surface)] px-4 py-3 text-[var(--text)] shadow-sm focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
  ></textarea>

  <p class="mt-2 text-xs text-[var(--text-6)]">
    100% in your browser — your text never leaves your device.
  </p>

  <div
    data-output
    class="mt-4 min-h-[3rem] select-all whitespace-pre-wrap break-words rounded-xl border border-[var(--border)] bg-[var(--surface-2)] px-4 py-3 text-lg text-[var(--text)]"
  >
  </div>

  <button
    type="button"
    data-copy
    class="mt-3 rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white hover:bg-[var(--accent-hover)]"
  >
    Copy
  </button>
</div>

<script>
  import '../scripts/fancy-tool.ts';
</script>
