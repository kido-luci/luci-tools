---
// "FROM → TO" format tile shown beside a converter's title (e.g. CM → Inches).
// Pure text in a tinted brand tile so it stays crisp and theme-aware.
interface Props {
  from: string;
  to: string;
  class?: string;
}
const { from, to, class: className = '' } = Astro.props;
---

<span
  class={`inline-flex flex-col items-start justify-center rounded-[20px] bg-tile-bg px-[18px] py-4 ${className}`}
  aria-hidden="true"
>
  <span class="font-display text-[21px] font-bold leading-none tracking-[-0.02em] text-tile-fg">{from}</span>
  <span class="mt-2 text-[15px] font-bold leading-none text-tile-fg opacity-80">→ {to}</span>
</span>
